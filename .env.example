# Postgres connection string (Neon / Vercel Postgres / Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Vercel Blob read/write token (Storage tab on your Vercel project)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Shared access code gate for the whole app
ACCESS_PASSWORD="change-me"

# Secret used to sign the login session cookie (any long random string)
SESSION_SECRET="change-me-too"
